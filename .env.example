# Override the default https://nexusgg-8ia.pages.dev origin if the domain changes.
NEXT_PUBLIC_SITE_URL=
# Set to 1 on private previews.
NEXT_PUBLIC_NO_INDEX=
# Optional. Paste only the content value from the Search Console HTML tag.
