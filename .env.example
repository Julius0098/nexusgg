NEXT_PUBLIC_CONTACT_EMAIL=
# Optional. Hidden ad mounts for a future, consent-aware integration.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_INTRO_SLOT=
NEXT_PUBLIC_ADSENSE_RESULT_SLOT=
NEXT_PUBLIC_ADSENSE_GUIDE_SLOT=
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT=
NEXT_PUBLIC_ADSENSE_TOURNAMENT_SLOT=
